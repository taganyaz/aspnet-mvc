@using SocialAssistanceProgram.Common.ViewModels
@using SocialAssistanceProgram.Common.Pagination
@model PaginatedList<ApplicantListViewModel>

@{
    ViewData["Title"] = "Applications";
    var currentPageSize = ViewBag.CurrentPageSize as int? ?? 10;
    var availablePageSizes = ViewBag.AvailablePageSizes as List<int> ?? new List<int> { 5, 10, 20, 50 };
    var filter = ViewBag.Filter as ApplicantFilterViewModel ?? new ApplicantFilterViewModel();
}

<h1>Applications</h1>

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">
            <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="@(filter.HasAnyFilter ? "true" : "false")" aria-controls="filterCollapse">
                <i class="fas fa-filter"></i> Filters @(filter.HasAnyFilter ? "(Active)" : "")
            </button>
        </h5>
    </div>
    <div id="filterCollapse" class="collapse @(filter.HasAnyFilter ? "show" : "")" data-bs-parent="#filterAccordion">
        <div class="card-body">
            <form asp-action="Index" method="get" id="filterForm">
                <input type="hidden" name="pageSize" value="@currentPageSize" />
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="@filter.NameFilter" class="form-label"></label>
                            <input asp-for="@filter.NameFilter" name="filter.NameFilter" class="form-control" placeholder="Search by first, middle, or last name" value="@filter.NameFilter" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="@filter.IdNumberFilter" class="form-label"></label>
                            <input asp-for="@filter.IdNumberFilter" name="filter.IdNumberFilter" class="form-control" placeholder="Search by ID number" value="@filter.IdNumberFilter" />
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="@filter.CountyId" class="form-label"></label>
                                    <select asp-for="@filter.CountyId" name="filter.CountyId" class="form-select" asp-items="ViewBag.FilterCountyId" id="filterCountyId">
                                        <option value="">-- Select County --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="@filter.SubCountyId" class="form-label"></label>
                                    <select asp-for="@filter.SubCountyId" name="filter.SubCountyId" class="form-select" asp-items="ViewBag.FilterSubCountyId" id="filterSubCountyId">
                                        <option value="">-- Select Sub County --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="@filter.LocationId" class="form-label"></label>
                                    <select asp-for="@filter.LocationId" name="filter.LocationId" class="form-select" asp-items="ViewBag.FilterLocationId" id="filterLocationId">
                                        <option value="">-- Select Location --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="@filter.SubLocationId" class="form-label"></label>
                                    <select asp-for="@filter.SubLocationId" name="filter.SubLocationId" class="form-select" asp-items="ViewBag.FilterSubLocationId" id="filterSubLocationId">
                                        <option value="">-- Select Sub Location --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="@filter.VillageId" class="form-label"></label>
                            <select asp-for="@filter.VillageId" name="filter.VillageId" class="form-select" asp-items="ViewBag.FilterVillageId" id="filterVillageId">
                                <option value="">-- Select Village --</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Apply Filters
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Clear Filters
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <p>
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </p>
    </div>
    <div class="col-md-6 text-end">
        <div class="d-flex align-items-center justify-content-end">
            <label for="pageSizeSelector" class="form-label me-2 mb-0">Items per page:</label>
            <select id="pageSizeSelector" class="form-select" style="width: auto;" onchange="changePageSize(this.value)">
                @foreach (var size in availablePageSizes)
                {
                    <option value="@size" selected="@(size == currentPageSize)">@size</option>
                }
            </select>
        </div>
    </div>
</div>

@if (Model.TotalCount > 0)
{
    <div class="mb-3">
        <p class="text-muted">
            Showing @Model.FirstItemOnPage to @Model.LastItemOnPage of @Model.TotalCount applications
            @if (filter.HasAnyFilter)
            {
                <span class="badge bg-info">Filtered</span>
            }
        </p>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead class="table-dark">
            <tr>
                <th style="min-width: 120px;">Application Date</th>
                <th style="min-width: 150px;">Full Name</th>
                <th style="min-width: 100px;">ID Number</th>
                <th style="min-width: 100px;">County</th>
                <th style="min-width: 120px;">Sub County</th>
                <th style="min-width: 100px;">Location</th>
                <th style="min-width: 120px;">Sub Location</th>
                <th style="min-width: 100px;">Village</th>
                <th style="min-width: 120px;">Officer</th>
                <th style="min-width: 120px;">Signed Date</th>
                <th style="min-width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
    @if (Model.Any())
    {
        @foreach (var item in Model) {
            <tr>
                <td>
                    @item.ApplicationDate.ToString("MMM dd, yyyy")
                </td>
                <td>
                    <span class="fw-medium">@item.FullName</span>
                </td>
                <td>
                    @item.IdNumber
                </td>
                <td>
                    @(item.County ?? "N/A")
                </td>
                <td>
                    @(item.SubCounty ?? "N/A")
                </td>
                <td>
                    @(item.Location ?? "N/A")
                </td>
                <td>
                    @(item.SubLocation ?? "N/A")
                </td>
                <td>
                    @(item.Village ?? "N/A")
                </td>
                <td>
                    @(item.Officer ?? "N/A")
                </td>
                <td>
                    @item.SignedDate.ToString("MMM dd, yyyy")
                </td>
                <td>
                    <div class="btn-group" role="group" aria-label="Actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="11" class="text-center">
                <div class="alert alert-info" role="alert">
                    @if (filter.HasAnyFilter)
                    {
                        <text>No applications found matching the selected filters.</text>
                    }
                    else
                    {
                        <text>No applications found.</text>
                    }
                </div>
            </td>
        </tr>
    }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";

    <nav aria-label="Applicants pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @prevDisabled">
                <a asp-action="Index" 
                   asp-route-pageNumber="@(Model.PageIndex - 1)" 
                   asp-route-pageSize="@currentPageSize"
                   asp-route-filter.NameFilter="@filter.NameFilter"
                   asp-route-filter.IdNumberFilter="@filter.IdNumberFilter"
                   asp-route-filter.CountyId="@filter.CountyId"
                   asp-route-filter.SubCountyId="@filter.SubCountyId"
                   asp-route-filter.LocationId="@filter.LocationId"
                   asp-route-filter.SubLocationId="@filter.SubLocationId"
                   asp-route-filter.VillageId="@filter.VillageId"
                   class="page-link" 
                   aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                    <span class="sr-only">Previous</span>
                </a>
            </li>
            
            @if (Model.PageIndex > 3)
            {
                <li class="page-item">
                    <a asp-action="Index" 
                       asp-route-pageNumber="1" 
                       asp-route-pageSize="@currentPageSize"
                       asp-route-filter.NameFilter="@filter.NameFilter"
                       asp-route-filter.IdNumberFilter="@filter.IdNumberFilter"
                       asp-route-filter.CountyId="@filter.CountyId"
                       asp-route-filter.SubCountyId="@filter.SubCountyId"
                       asp-route-filter.LocationId="@filter.LocationId"
                       asp-route-filter.SubLocationId="@filter.SubLocationId"
                       asp-route-filter.VillageId="@filter.VillageId"
                       class="page-link">1</a>
                </li>
                if (Model.PageIndex > 4)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }
            
            @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a asp-action="Index" 
                       asp-route-pageNumber="@i" 
                       asp-route-pageSize="@currentPageSize"
                       asp-route-filter.NameFilter="@filter.NameFilter"
                       asp-route-filter.IdNumberFilter="@filter.IdNumberFilter"
                       asp-route-filter.CountyId="@filter.CountyId"
                       asp-route-filter.SubCountyId="@filter.SubCountyId"
                       asp-route-filter.LocationId="@filter.LocationId"
                       asp-route-filter.SubLocationId="@filter.SubLocationId"
                       asp-route-filter.VillageId="@filter.VillageId"
                       class="page-link">@i</a>
                </li>
            }
            
            @if (Model.PageIndex < Model.TotalPages - 2)
            {
                if (Model.PageIndex < Model.TotalPages - 3)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
                <li class="page-item">
                    <a asp-action="Index" 
                       asp-route-pageNumber="@Model.TotalPages" 
                       asp-route-pageSize="@currentPageSize"
                       asp-route-filter.NameFilter="@filter.NameFilter"
                       asp-route-filter.IdNumberFilter="@filter.IdNumberFilter"
                       asp-route-filter.CountyId="@filter.CountyId"
                       asp-route-filter.SubCountyId="@filter.SubCountyId"
                       asp-route-filter.LocationId="@filter.LocationId"
                       asp-route-filter.SubLocationId="@filter.SubLocationId"
                       asp-route-filter.VillageId="@filter.VillageId"
                       class="page-link">@Model.TotalPages</a>
                </li>
            }
            
            <li class="page-item @nextDisabled">
                <a asp-action="Index" 
                   asp-route-pageNumber="@(Model.PageIndex + 1)" 
                   asp-route-pageSize="@currentPageSize"
                   asp-route-filter.NameFilter="@filter.NameFilter"
                   asp-route-filter.IdNumberFilter="@filter.IdNumberFilter"
                   asp-route-filter.CountyId="@filter.CountyId"
                   asp-route-filter.SubCountyId="@filter.SubCountyId"
                   asp-route-filter.LocationId="@filter.LocationId"
                   asp-route-filter.SubLocationId="@filter.SubLocationId"
                   asp-route-filter.VillageId="@filter.VillageId"
                   class="page-link"
                   aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                    <span class="sr-only">Next</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="text-center mt-3">
        <p class="text-muted">
            Page @Model.PageIndex of @Model.TotalPages 
            (@Model.Count items on this page)
        </p>
    </div>
}

@section Scripts {
    <script type="text/javascript">
        function changePageSize(newPageSize) {
            var form = document.getElementById('filterForm');
            var pageSizeInput = form.querySelector('input[name="pageSize"]');
            pageSizeInput.value = newPageSize;
            
            // Reset to first page when changing page size
            var pageNumberInput = form.querySelector('input[name="pageNumber"]');
            if (pageNumberInput) {
                pageNumberInput.value = '1';
            } else {
                var hiddenPageNumber = document.createElement('input');
                hiddenPageNumber.type = 'hidden';
                hiddenPageNumber.name = 'pageNumber';
                hiddenPageNumber.value = '1';
                form.appendChild(hiddenPageNumber);
            }
            
            form.submit();
        }
        
        // Set the correct selected option on page load
        document.addEventListener('DOMContentLoaded', function() {
            var selector = document.getElementById('pageSizeSelector');
            if (selector) {
                selector.value = '@currentPageSize';
            }
        });

        // Cascading dropdowns for filter
        document.addEventListener('DOMContentLoaded', function() {
            // Filter County change
            document.getElementById('filterCountyId').addEventListener('change', function() {
                var countyId = this.value;
                var subCountySelect = document.getElementById('filterSubCountyId');
                var locationSelect = document.getElementById('filterLocationId');
                var subLocationSelect = document.getElementById('filterSubLocationId');
                var villageSelect = document.getElementById('filterVillageId');
                
                // Clear dependent dropdowns
                clearSelect(subCountySelect);
                clearSelect(locationSelect);
                clearSelect(subLocationSelect);
                clearSelect(villageSelect);
                
                if (countyId) {
                    fetch('/Applicants/GetSubCounties?countyId=' + countyId)
                        .then(response => response.json())
                        .then(data => {
                            populateSelect(subCountySelect, data, '-- Select Sub County --');
                        });
                }
            });

            // Filter Sub County change
            document.getElementById('filterSubCountyId').addEventListener('change', function() {
                var subCountyId = this.value;
                var locationSelect = document.getElementById('filterLocationId');
                var subLocationSelect = document.getElementById('filterSubLocationId');
                var villageSelect = document.getElementById('filterVillageId');
                
                // Clear dependent dropdowns
                clearSelect(locationSelect);
                clearSelect(subLocationSelect);
                clearSelect(villageSelect);
                
                if (subCountyId) {
                    fetch('/Applicants/GetLocations?subCountyId=' + subCountyId)
                        .then(response => response.json())
                        .then(data => {
                            populateSelect(locationSelect, data, '-- Select Location --');
                        });
                }
            });

            // Filter Location change
            document.getElementById('filterLocationId').addEventListener('change', function() {
                var locationId = this.value;
                var subLocationSelect = document.getElementById('filterSubLocationId');
                var villageSelect = document.getElementById('filterVillageId');
                
                // Clear dependent dropdowns
                clearSelect(subLocationSelect);
                clearSelect(villageSelect);
                
                if (locationId) {
                    fetch('/Applicants/GetSubLocations?locationId=' + locationId)
                        .then(response => response.json())
                        .then(data => {
                            populateSelect(subLocationSelect, data, '-- Select Sub Location --');
                        });
                }
            });

            // Filter Sub Location change
            document.getElementById('filterSubLocationId').addEventListener('change', function() {
                var subLocationId = this.value;
                var villageSelect = document.getElementById('filterVillageId');
                
                // Clear dependent dropdown
                clearSelect(villageSelect);
                
                if (subLocationId) {
                    fetch('/Applicants/GetVillages?subLocationId=' + subLocationId)
                        .then(response => response.json())
                        .then(data => {
                            populateSelect(villageSelect, data, '-- Select Village --');
                        });
                }
            });
        });

        function clearSelect(selectElement) {
            selectElement.innerHTML = '<option value="">-- Select --</option>';
        }

        function populateSelect(selectElement, data, defaultText) {
            selectElement.innerHTML = '<option value="">' + defaultText + '</option>';
            data.forEach(function(item) {
                var option = document.createElement('option');
                option.value = item.value;
                option.textContent = item.text;
                selectElement.appendChild(option);
            });
        }
    </script>
}
